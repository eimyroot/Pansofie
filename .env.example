NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=PASTE_LOCAL_PUBLISHABLE_KEY_FROM_SUPABASE_STATUS
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SITE_INDEXABLE=false

# Server-only AI mentor configuration. Never expose this value through NEXT_PUBLIC_*.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Explicit production gate. Keep false until provider/privacy review is complete.
MENTOR_PRODUCTION_ENABLED=false
# Allowed acknowledged modes: standard_api | zdr. Default unverified keeps mentor offline.
ANTHROPIC_DATA_RETENTION_MODE=unverified
# Must stay false until the Claude Console workspace has a reviewed monthly spend limit.
MENTOR_PROVIDER_SPEND_LIMIT_VERIFIED=false
# Intended provider-side monthly cap; application DB also enforces its own independent ceiling.
MENTOR_PROVIDER_MONTHLY_SPEND_LIMIT_USD=25
# Paid smoke tests are opt-in and must use synthetic content only.
MENTOR_LIVE_SMOKE=0
